{
     "builds": [
          {
               "src": "api/health.py",
               "use": "@vercel/python",
               "config": {
                    "maxLambdaSize": "15mb"
               }
          },
          {
               "src": "api/v1/command.py",
               "use": "@vercel/python",
               "config": {
                    "maxLambdaSize": "15mb"
               }
          }
     ],
     "routes": [
          {
               "src": "/api/(.*)",
               "dest": "/api/$1.py"
          }
     ]
}